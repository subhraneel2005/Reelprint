# Chat + transcription + embeddings (pick at least one chat provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TRANSCRIBE_MODEL=whisper-1

# OpenRouter: chat, vision, embeddings, and Whisper audio through one key
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
OPENROUTER_TRANSCRIBE_MODEL=openai/whisper-1

# Optional provider preference: openrouter | openai | gemini
AI_PROVIDER=

# Optional chat / audio / vision fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Live Shorts discovery (free key from Google Cloud, enable YouTube Data API v3)
YOUTUBE_API_KEY=

# Instagram transcript + metadata without cookies (free tier at supadata.ai)
SUPADATA_API_KEY=

# Local Instagram/TikTok session for yt-dlp (choose one; never commit)
IG_COOKIES_FROM_BROWSER=
IG_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_COOKIES_FILE=
