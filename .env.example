# Copy this file to .env.local (local) and pass it to Compose with --env-file.
# ── AI ─────────────────────────────────────────────────────────────
# OpenRouter alone runs the entire AI pipeline:
#   chat + structured DNA/research, vision, embeddings, and Whisper transcription.
# Nothing else is required for the AI features.
# Audio transcription requires at least $0.50 of OpenRouter credit.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
OPENROUTER_TRANSCRIBE_MODEL=openai/whisper-1

# Optional: force a provider when more than one key is present.
AI_PROVIDER=

# Optional: the public URL used for OpenRouter attribution (no trailing slash).
APP_URL=http://localhost:3000

# ── Optional AI fallbacks (not needed with OpenRouter) ─────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Optional OpenAI-compatible gateway, e.g. https://api.openai.com/v1
OPENAI_BASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── Optional data sources ───────────────────────────────────────────
# Live Shorts discovery (free key from Google Cloud, enable YouTube Data API v3)
YOUTUBE_API_KEY=

# Instagram transcript + metadata without cookies (free tier at supadata.ai)
SUPADATA_API_KEY=

# Local Instagram/TikTok session for yt-dlp (choose one; never commit)
IG_COOKIES_FROM_BROWSER=
IG_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_COOKIES_FILE=
